# REST API base URL (includes API version).
NEXT_PUBLIC_BACKEND_BASE_URL=https://be.emilist.com/api/v1
# Socket.IO server origin (does not include /api/v1).
NEXT_PUBLIC_SOCKET_URL=https://be.emilist.com
# Browser return URL used by payment flows; set for each environment.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Canonical SEO domain and absolute social-preview image URLs.
# Change this when the custom domain points to this deployment.
SITE_URL=https://emilist-v2.vercel.app
# Optional matching value used when copying public share links in the browser.
NEXT_PUBLIC_SITE_URL=https://emilist-v2.vercel.app
